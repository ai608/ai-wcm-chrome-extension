{
  "name": "wcm-sales-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "WXT_RELEASE=1 wxt zip",
    "zip:br": "WXT_RELEASE=1 wxt build && node scripts/pack-br.mjs",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check --write .",
    "lint": "biome lint .",
    "size": "node scripts/check-size.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/poppins": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "@webext-core/messaging": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^21.0.1",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vitest": "^5.0.4",
    "wxt": "^0.21.4"
  }
}
