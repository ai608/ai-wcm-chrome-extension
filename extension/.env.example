# GHL host(s) the SDRs use, comma-separated, no protocol
WXT_GHL_HOST=app.practiceflow.md,app.gohighlevel.com
# O4 backend base URL (no trailing slash)
WXT_API_BASE_URL=http://localhost:8001
WXT_O1_WEB_URL=http://localhost:5173
# true = background answers every request from in-memory mock data
WXT_API_MOCK=true
