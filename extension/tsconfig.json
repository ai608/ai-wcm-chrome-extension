{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "paths": { "@/*": ["./src/*"] },
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["chrome", "vite/client"]
  },
  "include": ["src", "wxt.config.ts", "vitest.config.ts", "scripts", ".wxt/wxt.d.ts"]
}
